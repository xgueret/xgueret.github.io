---
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { getSeriesNav } from '../../utils/series';

const locale = 'fr';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id, data }) => {
    return id.startsWith('fr/') && !data.draft && !data.archived;
  });

  return posts.map((post) => ({
    params: { slug: post.id.replace('fr/', '').replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const readingTime = getReadingTime(post.body ?? '');
const { episodes, prev, next } = await getSeriesNav(post, locale);
---

<PostLayout
  title={post.data.title}
  date={post.data.date}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
  categories={post.data.categories}
  description={post.data.description}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  locale={locale}
  readingTime={readingTime}
  headings={headings}
  toc={post.data.toc}
  seriesName={post.data.series}
  seriesEpisodes={episodes}
  seriesPrev={prev}
  seriesNext={next}
>
  <Content />
</PostLayout>
