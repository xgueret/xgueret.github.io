---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import { t } from '../../i18n';

const locale = 'en';
const site = 'https://xgueret.github.io';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: t(locale, 'contactTitle'),
  description: t(locale, 'contactDescription'),
  url: `${site}/en/contact/`,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'Person',
    name: 'Xavier GUERET',
    url: `${site}/en/`,
    sameAs: ['https://github.com/xgueret', 'https://gitlab.com/xgueret', 'https://linkedin.com/in/xgueret'],
  },
};
---

<BaseLayout title={t(locale, 'contactTitle')} description={t(locale, 'contactDescription')} locale={locale} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <SectionEyebrow text={t(locale, 'contactTitle')} />
      <p class="mt-3 text-[var(--color-text-muted)] text-lg max-w-2xl text-pretty">
        {t(locale, 'contactDescription')}
      </p>
    </header>

    <div class="max-w-xl">
      <form
        action="https://formspree.io/f/xjgegddj"
        method="POST"
        id="contact-form"
        class="space-y-6"
      >
        <div>
          <label for="name" class="block text-sm font-medium text-[var(--color-text)] mb-1">
            {t(locale, 'contactName')}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder={t(locale, 'contactNamePlaceholder')}
            class="w-full px-4 py-2.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)]/50 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-shadow"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-[var(--color-text)] mb-1">
            {t(locale, 'contactEmail')}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder={t(locale, 'contactEmailPlaceholder')}
            class="w-full px-4 py-2.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)]/50 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-shadow"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-[var(--color-text)] mb-1">
            {t(locale, 'contactMessage')}
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            placeholder={t(locale, 'contactMessagePlaceholder')}
            class="w-full px-4 py-2.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder:text-[var(--color-text-muted)]/50 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-shadow resize-y"
          ></textarea>
        </div>

        <button
          type="submit"
          class="btn btn-primary"
        >
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          {t(locale, 'contactSend')}
        </button>

        <div id="form-success" class="hidden p-4 rounded-lg bg-green-50 text-green-800 dark:bg-green-900/20 dark:text-green-300 text-sm" role="status" aria-live="polite">
          {t(locale, 'contactSuccess')}
        </div>
        <div id="form-error" class="hidden p-4 rounded-lg bg-red-50 text-red-800 dark:bg-red-900/20 dark:text-red-300 text-sm" role="alert" aria-live="assertive">
          {t(locale, 'contactError')}
        </div>
      </form>

      <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <p class="text-sm text-[var(--color-text-muted)] mb-4">{t(locale, 'contactOrSocial')}</p>
        <div class="flex gap-4">
          <a href="https://www.linkedin.com/in/xavier-gueret-47bb3019b/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--color-bg-section)] text-[var(--color-text)] no-underline text-sm font-medium hover:bg-[var(--color-border)] transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none">
            <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="https://github.com/xgueret/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--color-bg-section)] text-[var(--color-text)] no-underline text-sm font-medium hover:bg-[var(--color-border)] transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none">
            <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success')!;
  const error = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    success.classList.add('hidden');
    error.classList.add('hidden');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        success.classList.remove('hidden');
      } else {
        error.classList.remove('hidden');
      }
    } catch {
      error.classList.remove('hidden');
    }
  });
</script>
