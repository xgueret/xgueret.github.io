---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrainingsGrid from '../../../components/TrainingsGrid.astro';
import SectionEyebrow from '../../../components/SectionEyebrow.astro';
import { t, localePrefix } from '../../../i18n';
import { getCollection } from 'astro:content';

const locale = 'en';
const site = 'https://xgueret.github.io';

const allTrainings = await getCollection('training', ({ id, data }) => {
  return id.startsWith('en/') && !data.draft;
});

const trainings = allTrainings.map((training) => ({
  title: training.data.title,
  description: training.data.description,
  href: training.data.externalLink || `${localePrefix(locale)}/training/`,
  isExternal: !!training.data.externalLink,
  tags: training.data.tags,
  image: training.data.image,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t(locale, 'recentTrainings'),
  description: t(locale, 'trainingsDescription'),
  url: `${site}/en/training/`,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Xavier GUERET', url: site },
};
---

<BaseLayout title={t(locale, 'recentTrainings')} description={t(locale, 'trainingsDescription')} locale={locale} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <SectionEyebrow text={t(locale, 'recentTrainings')} />
    </header>

    <TrainingsGrid trainings={trainings} locale={locale} showViewAll={false} />
  </div>
</BaseLayout>
