---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CredentialsStrip from '../../components/CredentialsStrip.astro';
import ArticlesFeaturedList from '../../components/ArticlesFeaturedList.astro';
import TrainingsFeaturedList from '../../components/TrainingsFeaturedList.astro';
import { t, localePrefix } from '../../i18n';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

const locale = 'en';
const site = 'https://xgueret.github.io';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Xavier GUERET',
      url: site,
      inLanguage: ['fr', 'en'],
    },
    {
      '@type': 'Person',
      name: 'Xavier GUERET',
      url: `${site}${localePrefix(locale)}/`,
      jobTitle: 'DevOps Engineer',
      sameAs: [
        'https://github.com/xgueret',
        'https://gitlab.com/xgueret',
        'https://linkedin.com/in/xgueret',
        'https://x.com/hixmaster',
      ],
    },
  ],
};

const allPosts = await getCollection('posts', ({ id, data }) => {
  return id.startsWith('en/') && !data.draft && !data.archived;
});
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const articles = recentPosts.map((post) => {
  let summary = post.data.description;
  if (!summary && post.body) {
    summary = post.body
      .replace(/^#+\s+.*/gm, '')
      .replace(/[*_`~\[\]]/g, '')
      .replace(/\n+/g, ' ')
      .trim()
      .slice(0, 150);
  }
  return {
    title: post.data.title,
    href: `${localePrefix(locale)}/posts/${post.id.replace('en/', '').replace(/\.md$/, '')}`,
    summary,
    image: post.data.image,
    date: post.data.date,
    readingMinutes: getReadingTime(post.body ?? ''),
  };
});

const allTrainings = await getCollection('training', ({ id, data }) => {
  return id.startsWith('en/') && !data.draft && !data.archived;
});
const trainings = allTrainings.map((t) => ({
  title: t.data.title,
  description: t.data.description,
  href: t.data.externalLink || `${localePrefix(locale)}/training/`,
  isExternal: !!t.data.externalLink,
  tags: t.data.tags,
  image: t.data.image,
}));
---

<BaseLayout title={t(locale, 'siteTitle')} locale={locale} jsonLd={jsonLd}>
  <Hero locale={locale} />

  <CredentialsStrip locale={locale} />

  <section id="featured" class="py-20 lg:py-28 bg-[var(--color-bg-section)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-[0.8125rem] font-medium tracking-[0.01em] text-[var(--color-accent)] mb-2">
          {t(locale, 'articlesEyebrow')}
        </p>
        <h2 class="font-serif font-medium text-[var(--color-text)] text-[clamp(1.5rem,3vw,2rem)] leading-tight tracking-tight text-balance">
          {t(locale, 'recentArticlesTitle')}
        </h2>
      </div>
      <ArticlesFeaturedList articles={articles} locale={locale} />
    </div>
  </section>

  {trainings.length > 0 && (
    <section class="py-16 lg:py-20 bg-[var(--color-bg)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
          <p class="text-[0.8125rem] font-medium tracking-[0.01em] text-[var(--color-accent)] mb-2">
            {t(locale, 'trainingsEyebrow')}
          </p>
          <h2 class="font-serif font-medium text-[var(--color-text)] text-[clamp(1.5rem,3vw,2rem)] leading-tight tracking-tight text-balance">
            {t(locale, 'recentTrainingsTitle')}
          </h2>
        </div>
        <TrainingsFeaturedList trainings={trainings} locale={locale} />
      </div>
    </section>
  )}
</BaseLayout>
