---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const locale = 'en';
const pages = await getCollection('pages', ({ id }) => id === 'en/projects.md');
const page = pages[0];
let Content;
if (page) {
  const rendered = await page.render();
  Content = rendered.Content;
}
const title = page?.data.title || 'Projects';
---

<PageLayout title={title} locale={locale}>
  {Content && <Content />}
</PageLayout>
