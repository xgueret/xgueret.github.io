---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { personLd } from '../../lib/person-ld';

const locale = 'en';
const site = Astro.site?.toString().replace(/\/$/, '') || '';

const pages = await getCollection('pages', ({ id }) => id === 'en/about.md');
const page = pages[0];
let Content;
if (page) {
  const rendered = await page.render();
  Content = rendered.Content;
}
const title = page?.data.title || 'About';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  url: `${site}/en/about/`,
  inLanguage: 'en',
  mainEntity: personLd(site, locale),
};
---

<PageLayout title={title} locale={locale} jsonLd={jsonLd}>
  {Content && <Content />}
</PageLayout>
