---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoriesCloud from '../../../components/CategoriesCloud.astro';
import ArticlesGrid from '../../../components/ArticlesGrid.astro';
import Pagination from '../../../components/Pagination.astro';
import { t, localePrefix } from '../../../i18n';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../../utils/readingTime';
import type { GetStaticPaths } from 'astro';

const locale = 'en';

export const getStaticPaths = (async () => {
  const PAGE_SIZE = 10;
  const allPosts = await getCollection('posts', ({ id, data }) => {
    return id.startsWith('en/') && !data.draft && !data.archived;
  });
  const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const categoryMap = new Map<string, number>();
  sortedPosts.forEach((post) => {
    post.data.categories.forEach((cat) => {
      categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
    });
  });
  const categories = Array.from(categoryMap.entries()).map(([name, count]) => ({
    name,
    count,
    href: `${localePrefix('en')}/categories/${name.toLowerCase()}/`,
  }));

  const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: {
      posts: sortedPosts.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
      currentPage: i + 1,
      totalPages,
      categories,
    },
  }));
}) satisfies GetStaticPaths;

const { posts, currentPage, totalPages, categories } = Astro.props;

const articles = posts.map((post) => {
  let summary = post.data.description;
  if (!summary && post.body) {
    summary = post.body
      .replace(/^#+\s+.*/gm, '')
      .replace(/[*_`~\[\]]/g, '')
      .replace(/\n+/g, ' ')
      .trim()
      .slice(0, 150);
  }
  return {
    title: post.data.title,
    href: `${localePrefix(locale)}/blog/${post.id.replace('en/', '').replace(/\.md$/, '')}`,
    summary,
    image: post.data.image,
    seriesName: post.data.series,
    seriesOrder: post.data.seriesOrder,
    date: post.data.date,
    readingMinutes: getReadingTime(post.body ?? ''),
  };
});
---

<BaseLayout title={t(locale, 'posts')} description={t(locale, 'postsDescription')} locale={locale}>
  <div class="mx-auto" style="max-width:1400px; padding:48px 28px 96px;">
    <header class="mb-12 flex flex-col" style="gap:22px;">
      <a href={`${localePrefix(locale)}/#tp-blog`} data-cursor="link" class="tp-back tp-link">
        <span style="color:#a8cf3e;">&larr;</span>
        <span>{t(locale, 'backHome')}</span>
      </a>
      <p class="tp-label" style="opacity:.8; margin:0;" data-split="1">{t(locale, 'blogLabel')}</p>
      <h1 class="tp-h2" data-split="1">{t(locale, 'blogTitle1')}<br />{t(locale, 'blogTitle2')}<br />{t(locale, 'blogTitle3')}</h1>
      <p style="margin:0; font-size:clamp(.95rem,1.3vw,1.1rem); line-height:1.55; font-weight:300; opacity:.9; max-width:52ch; text-wrap:pretty;" data-split="1">{t(locale, 'blogIntro')}</p>
    </header>

    <CategoriesCloud categories={categories} locale={locale} />

    <ArticlesGrid articles={articles} locale={locale} showViewAll={false} />

    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`${localePrefix(locale)}/blog/`} locale={locale} />
  </div>
</BaseLayout>
