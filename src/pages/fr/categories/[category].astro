---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoriesCloud from '../../../components/CategoriesCloud.astro';
import { t, formatDate } from '../../../i18n';
import { getCollection } from 'astro:content';

const locale = 'fr';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ id, data }) => {
    return id.startsWith('fr/') && !data.draft;
  });

  const categoryMap = new Map<string, typeof allPosts>();
  allPosts.forEach((post) => {
    post.data.categories.forEach((cat) => {
      const key = cat.toLowerCase();
      if (!categoryMap.has(key)) categoryMap.set(key, []);
      categoryMap.get(key)!.push(post);
    });
  });

  const allCategories = Array.from(categoryMap.entries()).map(([name, posts]) => ({
    name,
    count: posts.length,
    href: `/fr/categories/${name}/`,
  }));

  return Array.from(categoryMap.entries()).map(([category, posts]) => ({
    params: { category },
    props: {
      categoryName: category,
      posts: posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
      categories: allCategories,
    },
  }));
}

const { categoryName, posts, categories } = Astro.props;
---

<BaseLayout title={categoryName} description={`${t(locale, 'articles')} ${categoryName} — ${posts.length} ${posts.length === 1 ? t(locale, 'article') : t(locale, 'articles')}`} locale={locale}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <CategoriesCloud categories={categories} locale={locale} />

    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-text)] capitalize text-balance">
        {categoryName}
      </h1>
      <p class="text-sm text-[var(--color-text-muted)] mt-2 italic">
        {posts.length} {posts.length === 1 ? t(locale, 'article') : t(locale, 'articles')}
      </p>
    </header>

    <ul class="list-none p-0 m-0">
      {posts.map((post) => (
        <li class="flex gap-6 py-4 border-b border-[var(--color-border)] items-baseline">
          <time
            datetime={post.data.date.toISOString()}
            class="text-[var(--color-text-light)] text-sm whitespace-nowrap min-w-[140px]"
          >
            {formatDate(post.data.date, locale)}
          </time>
          <a
            href={`/${locale}/posts/${post.id.replace('fr/', '').replace(/\.md$/, '')}`}
            class="text-lg font-medium text-[var(--color-text)] no-underline hover:text-[var(--color-accent)] transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none focus-visible:rounded-md"
          >
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
