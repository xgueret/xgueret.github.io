---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoriesCloud from '../../components/CategoriesCloud.astro';
import ArticlesGrid from '../../components/ArticlesGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { t, localePrefix } from '../../i18n';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { sortCategoryPosts } from '../../utils/series';
import { assertCategoriesMapped } from '../../i18n/categories';

const locale = 'fr';

export async function getStaticPaths() {
  const PAGE_SIZE = 10;
  const allPosts = await getCollection('posts', ({ id, data }) => {
    return id.startsWith('fr/') && !data.draft && !data.archived;
  });

  const categoryMap = new Map<string, typeof allPosts>();
  allPosts.forEach((post) => {
    post.data.categories.forEach((cat) => {
      const key = cat.toLowerCase();
      if (!categoryMap.has(key)) categoryMap.set(key, []);
      categoryMap.get(key)!.push(post);
    });
  });

  assertCategoriesMapped(Array.from(categoryMap.keys()), 'fr');

  const allCategories = Array.from(categoryMap.entries()).map(([name, posts]) => ({
    name,
    count: posts.length,
    href: `/categories/${name}/`,
  }));

  const paths: Array<{
    params: { path: string | undefined };
    props: {
      categoryName: string;
      posts: typeof allPosts;
      categories: typeof allCategories;
      currentPage: number;
      totalPages: number;
      totalPosts: number;
    };
  }> = [];

  for (const [category, posts] of categoryMap.entries()) {
    const sortedPosts = sortCategoryPosts(posts);
    const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);

    for (let i = 0; i < totalPages; i++) {
      paths.push({
        params: { path: i === 0 ? category : `${category}/${i + 1}` },
        props: {
          categoryName: category,
          posts: sortedPosts.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
          categories: allCategories,
          currentPage: i + 1,
          totalPages,
          totalPosts: sortedPosts.length,
        },
      });
    }
  }

  return paths;
}

const { categoryName, posts, categories, currentPage, totalPages, totalPosts } = Astro.props;

const articles = posts.map((post) => {
  let summary = post.data.description;
  if (!summary && post.body) {
    summary = post.body
      .replace(/^#+\s+.*/gm, '')
      .replace(/[*_`~\[\]]/g, '')
      .replace(/\n+/g, ' ')
      .trim()
      .slice(0, 150);
  }
  return {
    title: post.data.title,
    href: `/blog/${post.id.replace('fr/', '').replace(/\.md$/, '')}`,
    summary,
    image: post.data.image,
    seriesName: post.data.series,
    seriesOrder: post.data.seriesOrder,
    date: post.data.date,
    readingMinutes: getReadingTime(post.body ?? ''),
  };
});
---

<BaseLayout title={categoryName} description={`${t(locale, 'articles')} ${categoryName} — ${totalPosts} ${totalPosts === 1 ? t(locale, 'article') : t(locale, 'articles')}`} locale={locale}>
  <div class="mx-auto" style="max-width:1400px; padding:48px 28px 96px;">
    <header class="mb-12 flex flex-col" style="gap:22px;">
      <p class="tp-label" style="opacity:.8; margin:0;" data-split="1">{t(locale, 'categoriesCloud')}</p>
      <h1 class="tp-h2" data-split="1">{categoryName}</h1>
      <p class="tp-label-sm" style="opacity:.62; margin:0;">{totalPosts} {totalPosts === 1 ? t(locale, 'article') : t(locale, 'articles')}</p>
    </header>

    <CategoriesCloud categories={categories} locale={locale} />

    <ArticlesGrid articles={articles} locale={locale} showViewAll={false} />

    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`${localePrefix(locale)}/categories/${categoryName}/`} locale={locale} />
  </div>
</BaseLayout>
