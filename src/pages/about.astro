---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const locale = 'fr';
const pages = await getCollection('pages', ({ id }) => id === 'fr/about.md');
const page = pages[0];
let Content;
if (page) {
  const rendered = await page.render();
  Content = rendered.Content;
}
const title = page?.data.title || 'A Propos';
---

<PageLayout title={title} locale={locale}>
  {Content && <Content />}
</PageLayout>
