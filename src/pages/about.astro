---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { personLd } from '../lib/person-ld';

const locale = 'fr';
const site = 'https://xgueret.github.io';

const pages = await getCollection('pages', ({ id }) => id === 'fr/about.md');
const page = pages[0];
let Content;
if (page) {
  const rendered = await page.render();
  Content = rendered.Content;
}
const title = page?.data.title || 'A Propos';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  url: `${site}/about/`,
  inLanguage: 'fr',
  mainEntity: personLd(site, locale),
};
---

<PageLayout title={title} locale={locale} jsonLd={jsonLd}>
  {Content && <Content />}
</PageLayout>
