---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticlesGrid from '../components/ArticlesGrid.astro';
import TrainingsGrid from '../components/TrainingsGrid.astro';
import { t, localePrefix } from '../i18n';
import { getCollection } from 'astro:content';

const locale = 'fr';
const site = 'https://xgueret.github.io';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Xavier GUERET',
      url: site,
      inLanguage: ['fr', 'en'],
    },
    {
      '@type': 'Person',
      name: 'Xavier GUERET',
      url: `${site}${localePrefix(locale)}/`,
      jobTitle: 'DevOps Engineer',
      sameAs: [
        'https://github.com/xgueret',
        'https://gitlab.com/xgueret',
        'https://linkedin.com/in/xgueret',
      ],
    },
  ],
};

// Get recent articles
const allPosts = await getCollection('posts', ({ id, data }) => {
  return id.startsWith('fr/') && !data.draft;
});
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const articles = recentPosts.map((post) => {
  let summary = post.data.description;
  if (!summary && post.body) {
    summary = post.body
      .replace(/^#+\s+.*/gm, '')
      .replace(/[*_`~\[\]]/g, '')
      .replace(/\n+/g, ' ')
      .trim()
      .slice(0, 150);
  }
  return {
    title: post.data.title,
    href: `${localePrefix(locale)}/posts/${post.id.replace('fr/', '').replace(/\.md$/, '')}`,
    summary,
    image: post.data.image,
  };
});

// Get trainings
const allTrainings = await getCollection('training', ({ id, data }) => {
  return id.startsWith('fr/') && !data.draft;
});
const trainings = allTrainings.map((t) => ({
  title: t.data.title,
  description: t.data.description,
  href: t.data.externalLink || `${localePrefix(locale)}/training/`,
  isExternal: !!t.data.externalLink,
  tags: t.data.tags,
  image: t.data.image,
}));
---

<BaseLayout title={t(locale, 'siteTitle')} locale={locale} jsonLd={jsonLd}>
  <Hero locale={locale} />

  <!-- Recent Articles -->
  <section id="featured" class="py-16 bg-[var(--color-bg-section)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)] mb-2">
          {t(locale, 'articlesEyebrow')}
        </p>
        <h2 class="text-3xl font-bold text-[var(--color-text)]">
          {t(locale, 'recentArticlesTitle')}
        </h2>
      </div>
      <ArticlesGrid articles={articles} locale={locale} />
    </div>
  </section>

  <!-- Trainings -->
  {trainings.length > 0 && (
    <section class="py-16 bg-[var(--color-bg)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-text-muted)] mb-2">
            {t(locale, 'trainingsEyebrow')}
          </p>
          <h2 class="text-3xl font-bold text-[var(--color-text)]">
            {t(locale, 'recentTrainingsTitle')}
          </h2>
        </div>
        <TrainingsGrid trainings={trainings} locale={locale} />
      </div>
    </section>
  )}
</BaseLayout>
