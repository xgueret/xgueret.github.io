---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesNav from '../components/SeriesNav.astro';
import SeriesHeader from '../components/SeriesHeader.astro';
import { type Locale, t, formatDate, localePrefix } from '../i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Episode {
  title: string;
  order: number;
  href: string;
  current: boolean;
}

interface Props {
  title: string;
  date: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  categories?: string[];
  description?: string;
  image?: string;
  imageAlt?: string;
  locale: Locale;
  readingTime?: number;
  headings?: Heading[];
  toc?: boolean;
  seriesName?: string;
  seriesEpisodes?: Episode[];
  seriesPrev?: Episode;
  seriesNext?: Episode;
}

const { title, date, updatedDate, author = 'Xavier GUERET', tags = [], categories = [], description, image, imageAlt, locale, readingTime, headings = [], toc = false, seriesName, seriesEpisodes = [], seriesPrev, seriesNext } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2);
const showToc = toc && tocHeadings.length > 1;
const heroAlt = imageAlt || title;
const modifiedDate = updatedDate || date;

const site = Astro.site?.toString().replace(/\/$/, '') || '';
const postUrl = `${site}${Astro.url.pathname}`;
const absoluteImage = image
  ? (image.startsWith('http') ? image : `${site}${image.startsWith('/') ? image : `/${image}`}`)
  : undefined;

const blogPostingLd = {
  '@type': 'BlogPosting',
  headline: title.slice(0, 110),
  datePublished: date.toISOString(),
  dateModified: modifiedDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    url: `${site}${localePrefix(locale)}/`,
  },
  publisher: {
    '@type': 'Person',
    name: 'Xavier GUERET',
    url: site,
  },
  ...(description && { description }),
  ...(absoluteImage && { image: absoluteImage }),
  url: postUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
  inLanguage: locale,
};

const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: locale === 'fr' ? 'Accueil' : 'Home',
      item: `${site}${localePrefix(locale)}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${site}${localePrefix(locale)}/blog/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: postUrl,
    },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [blogPostingLd, breadcrumbLd],
};
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  ogType="article"
  ogImage={absoluteImage}
  publishedTime={date.toISOString()}
  modifiedTime={modifiedDate.toISOString()}
  authorName={author}
  tags={tags}
  jsonLd={jsonLd}
>
  <article class="mx-auto" style="max-width:1400px; padding:48px 28px 96px;">
    <header class="mb-12">
      {/* The way back out, in reach from the top as well as from the footer. */}
      <div style="margin-bottom:32px;">
        <a href={`${localePrefix(locale)}/blog/`} data-cursor="link" class="tp-link">
          <span class="tp-arrow">&larr;</span>
          <span>{t(locale, 'backToBlog')}</span>
        </a>
      </div>
      <p class="tp-label" style="opacity:.8; margin:0 0 22px;" data-split="1">{t(locale, 'blogEyebrow')}</p>
      <h1 class="uppercase" style="margin:0; font-size:clamp(1.9rem,4.5vw,3.6rem); font-weight:500; line-height:.95; letter-spacing:.01em; text-wrap:balance; max-width:22ch;" data-split="1">
        {title}
      </h1>
      <div class="tp-label-sm flex flex-wrap items-baseline" style="gap:8px 18px; margin-top:22px; letter-spacing:.26em; opacity:.62;">
        <time datetime={date.toISOString()}>{t(locale, 'publishedOn')} {formatDate(date, locale)}</time>
        {author && <span>{t(locale, 'by')} {author}</span>}
        {readingTime && <span>{readingTime} {t(locale, 'minRead')}</span>}
      </div>
      {(tags.length > 0 || categories.length > 0) && (
        <div class="flex flex-wrap" style="gap:8px; margin-top:22px;">
          {categories.map((cat) => (
            <a href={`${localePrefix(locale)}/categories/${cat.toLowerCase()}/`} data-cursor="link" class="tp-label tp-tag" style="padding:8px 14px; border:1px solid rgba(255,255,255,.35); letter-spacing:.22em; color:#a8cf3e;">{cat}</a>
          ))}
          {tags.map((tag) => (
            <span class="tp-label" style="padding:8px 14px; border:1px solid rgba(255,255,255,.18); letter-spacing:.22em; opacity:.74;">{tag}</span>
          ))}
        </div>
      )}
      {seriesName && seriesEpisodes.length > 0 && (
        <SeriesHeader seriesName={seriesName} episodes={seriesEpisodes} locale={locale} />
      )}
    </header>

    {/* In colour: on the article itself the image is the subject, not a thumbnail. */}
    {image && (
      <div class="mb-12" style="border:1px solid rgba(255,255,255,.2);">
        <img src={image} alt={heroAlt} class="block w-full object-cover" style="aspect-ratio:3/1;" />
      </div>
    )}

    <div data-toc-grid class:list={["gap-x-10", showToc && "lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]"]}>
      {showToc && <TableOfContents headings={headings} locale={locale} />}
      <div class="prose prose-invert prose-lg max-w-none prose-headings:scroll-mt-[calc(var(--navbar-height)+1.5rem)]">
        <slot />
      </div>
    </div>

    {seriesName && seriesEpisodes.length > 0 && (
      <SeriesNav seriesName={seriesName} episodes={seriesEpisodes} prev={seriesPrev} next={seriesNext} locale={locale} />
    )}

    <footer class="mt-16 pt-8" style="border-top:1px solid rgba(255,255,255,.18);">
      <a href={`${localePrefix(locale)}/blog/`} data-cursor="link" class="tp-link">
        <span class="tp-arrow">←</span>
        <span>{t(locale, 'backToBlog')}</span>
      </a>
    </footer>
  </article>

<style>
  .tp-tag:hover { opacity: 1; border-color: #a8cf3e; }
</style>
</BaseLayout>
