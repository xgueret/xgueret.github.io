---
import BaseLayout from './BaseLayout.astro';
import { type Locale, t, formatDate } from '../i18n';

interface Props {
  title: string;
  date: Date;
  author?: string;
  tags?: string[];
  categories?: string[];
  description?: string;
  locale: Locale;
}

const { title, date, author = 'Xavier GUERET', tags = [], categories = [], description, locale } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') || '';
const postUrl = `${site}${Astro.url.pathname}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: date.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    url: `${site}/${locale}/`,
  },
  ...(description && { description }),
  url: postUrl,
};
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  ogType="article"
  publishedTime={date.toISOString()}
  authorName={author}
  jsonLd={jsonLd}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-text)] mb-4 leading-tight text-balance">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-text-light)]">
        <time datetime={date.toISOString()}>
          {t(locale, 'publishedOn')} {formatDate(date, locale)}
        </time>
        {author && <span>{t(locale, 'by')} {author}</span>}
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium bg-[var(--color-bg-section)] text-[var(--color-text-muted)] rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
      {categories.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-3">
          {categories.map((cat) => (
            <a
              href={`/${locale}/categories/${cat.toLowerCase()}`}
              class="px-3 py-1 text-xs font-medium bg-[var(--color-accent)]/10 text-[var(--color-accent)] rounded-full hover:bg-[var(--color-accent)]/20 transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none"
            >
              {cat}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-lg max-w-none
      prose-headings:text-[var(--color-text)] prose-headings:font-bold
      prose-p:text-[var(--color-text-muted)] prose-p:leading-relaxed
      prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
      prose-strong:text-[var(--color-text)]
      prose-code:text-[var(--color-text)] prose-code:bg-[var(--color-bg-section)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
      prose-pre:bg-[var(--color-primary-dark)] prose-pre:rounded-lg
      prose-pre:code:bg-transparent prose-pre:code:text-gray-100
      prose-blockquote:border-l-4 prose-blockquote:border-[var(--color-accent)]
      prose-img:rounded-lg
      prose-li:text-[var(--color-text-muted)]
      dark:prose-invert">
      <slot />
    </div>

    <footer class="mt-12 pt-8 border-t border-[var(--color-border)]">
      <a
        href={`/${locale}/posts/`}
        class="group/back inline-flex items-center gap-2 text-[var(--color-accent)] font-medium focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none focus-visible:rounded-md"
      >
        <span class="transition-transform duration-200 group-hover/back:-translate-x-1">&larr;</span>
        {t(locale, 'backToBlog')}
      </a>
    </footer>
  </article>
</BaseLayout>
