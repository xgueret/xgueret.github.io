---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesNav from '../components/SeriesNav.astro';
import SeriesHeader from '../components/SeriesHeader.astro';
import { type Locale, t, formatDate, localePrefix } from '../i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Episode {
  title: string;
  order: number;
  href: string;
  current: boolean;
}

interface Props {
  title: string;
  date: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  categories?: string[];
  description?: string;
  image?: string;
  imageAlt?: string;
  locale: Locale;
  readingTime?: number;
  headings?: Heading[];
  toc?: boolean;
  seriesName?: string;
  seriesEpisodes?: Episode[];
  seriesPrev?: Episode;
  seriesNext?: Episode;
}

const { title, date, updatedDate, author = 'Xavier GUERET', tags = [], categories = [], description, image, imageAlt, locale, readingTime, headings = [], toc = false, seriesName, seriesEpisodes = [], seriesPrev, seriesNext } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2);
const showToc = toc && tocHeadings.length > 1;
const heroAlt = imageAlt || title;
const modifiedDate = updatedDate || date;

const site = Astro.site?.toString().replace(/\/$/, '') || '';
const postUrl = `${site}${Astro.url.pathname}`;
const absoluteImage = image
  ? (image.startsWith('http') ? image : `${site}${image.startsWith('/') ? image : `/${image}`}`)
  : undefined;

const blogPostingLd = {
  '@type': 'BlogPosting',
  headline: title.slice(0, 110),
  datePublished: date.toISOString(),
  dateModified: modifiedDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    url: `${site}${localePrefix(locale)}/`,
  },
  publisher: {
    '@type': 'Person',
    name: 'Xavier GUERET',
    url: site,
  },
  ...(description && { description }),
  ...(absoluteImage && { image: absoluteImage }),
  url: postUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
  inLanguage: locale,
};

const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: locale === 'fr' ? 'Accueil' : 'Home',
      item: `${site}${localePrefix(locale)}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${site}${localePrefix(locale)}/blog/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: postUrl,
    },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [blogPostingLd, breadcrumbLd],
};
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  ogType="article"
  ogImage={absoluteImage}
  publishedTime={date.toISOString()}
  modifiedTime={modifiedDate.toISOString()}
  authorName={author}
  tags={tags}
  jsonLd={jsonLd}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {image && (
      <div class="mb-8 overflow-hidden rounded-xl">
        <img src={image} alt={heroAlt} class="w-full h-auto object-cover aspect-[3/1]" />
      </div>
    )}
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-text)] mb-4 leading-tight text-balance">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-text-light)]">
        <time datetime={date.toISOString()}>
          {t(locale, 'publishedOn')} {formatDate(date, locale)}
        </time>
        {author && <span>{t(locale, 'by')} {author}</span>}
        {readingTime && <span>· {readingTime} {t(locale, 'minRead')}</span>}
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium bg-[var(--color-bg-section)] text-[var(--color-text-muted)] rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
      {categories.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-3">
          {categories.map((cat) => (
            <a
              href={`${localePrefix(locale)}/categories/${cat.toLowerCase()}`}
              class="px-3 py-1 text-xs font-medium bg-[var(--color-accent)]/10 text-[var(--color-accent)] rounded-full hover:bg-[var(--color-accent)]/20 transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none"
            >
              {cat}
            </a>
          ))}
        </div>
      )}
      {seriesName && seriesEpisodes.length > 0 && (
        <SeriesHeader seriesName={seriesName} episodes={seriesEpisodes} locale={locale} />
      )}
    </header>

    <div data-toc-grid class:list={["gap-x-10", showToc && "lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]"]}>
      {showToc && <TableOfContents headings={headings} locale={locale} />}
      <div class="prose prose-lg max-w-none
        prose-headings:text-[var(--color-text)] prose-headings:font-bold
        prose-headings:scroll-mt-[calc(var(--navbar-height)+1.5rem)]
        prose-p:text-[var(--color-text-muted)] prose-p:leading-relaxed
        prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
        prose-strong:text-[var(--color-text)]
        prose-code:text-[var(--color-text)] prose-code:bg-[var(--color-bg-section)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
        prose-pre:bg-[var(--color-primary-dark)] prose-pre:rounded-lg
        prose-pre:code:bg-transparent prose-pre:code:text-gray-100
        prose-blockquote:border-l-4 prose-blockquote:border-[var(--color-accent)]
        prose-img:rounded-lg
        prose-li:text-[var(--color-text-muted)]
        dark:prose-invert">
        <slot />
      </div>
    </div>

    {seriesName && seriesEpisodes.length > 0 && (
      <SeriesNav
        seriesName={seriesName}
        episodes={seriesEpisodes}
        prev={seriesPrev}
        next={seriesNext}
        locale={locale}
      />
    )}

    <footer class="mt-12 pt-8 border-t border-[var(--color-border)]">
      <a
        href={`${localePrefix(locale)}/blog/`}
        class="group/back inline-flex items-center gap-2 text-[var(--color-accent)] font-medium focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none focus-visible:rounded-md"
      >
        <span class="transition-transform duration-200 group-hover/back:-translate-x-1">&larr;</span>
        {t(locale, 'backToBlog')}
      </a>
    </footer>
  </article>
</BaseLayout>
