---
import BaseLayout from './BaseLayout.astro';
import { type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  jsonLd?: Record<string, unknown>;
}

const { title, description, locale, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} locale={locale} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-text)] text-balance">
        {title}
      </h1>
    </header>
    <div class="prose prose-lg max-w-none
      prose-headings:text-[var(--color-text)] prose-headings:font-bold
      prose-p:text-[var(--color-text-muted)] prose-p:leading-relaxed
      prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
      prose-strong:text-[var(--color-text)]
      prose-code:text-[var(--color-text)] prose-code:bg-[var(--color-bg-section)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
      prose-pre:bg-[var(--color-primary-dark)] prose-pre:rounded-lg
      prose-pre:code:bg-transparent prose-pre:code:text-gray-100
      prose-li:text-[var(--color-text-muted)]
      dark:prose-invert">
      <slot />
    </div>
  </div>
</BaseLayout>
