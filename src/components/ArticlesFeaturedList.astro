---
import { type Locale, t, localePrefix, formatDate } from '../i18n';

interface Article {
  title: string;
  href: string;
  summary?: string;
  image?: string;
  date: Date;
  readingMinutes: number;
}

interface Props {
  articles: Article[];
  locale: Locale;
  showViewAll?: boolean;
}

const { articles, locale, showViewAll = true } = Astro.props;
const [featured, ...rest] = articles;
const minReadLabel = t(locale, 'minRead');
---

{articles.length > 0 && (
  <div class="space-y-12 lg:space-y-16">
    {featured && (
      <article class="group">
        <a
          href={featured.href}
          class="block overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] no-underline transition-colors duration-200 hover:border-[var(--color-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          <div class="aspect-[21/9] overflow-hidden bg-[var(--color-bg-alt)]">
            {featured.image ? (
              <img
                src={featured.image}
                alt={featured.title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center px-6 py-8">
                <h3 class="max-w-3xl text-balance text-center font-serif font-medium italic leading-[1.05] tracking-[-0.01em] text-[var(--color-text)] text-[clamp(1.75rem,5vw,3rem)]">
                  {featured.title}
                </h3>
              </div>
            )}
          </div>
          <div class="px-6 py-7 lg:px-9 lg:py-9">
            <p class="mb-3 text-[0.8125rem] font-medium tracking-[0.01em] text-[var(--color-text-light)]">
              <time datetime={featured.date.toISOString()}>{formatDate(featured.date, locale)}</time>
              <span aria-hidden="true"> · </span>
              <span>{`${featured.readingMinutes} ${minReadLabel}`}</span>
            </p>
            {featured.image && (
              <h3 class="mb-3 text-balance font-serif font-medium leading-[1.15] tracking-[-0.01em] text-[var(--color-text)] text-[clamp(1.5rem,3.2vw,2rem)]">
                {featured.title}
              </h3>
            )}
            {featured.summary && (
              <p class="max-w-prose text-pretty text-[1.0625rem] leading-relaxed text-[var(--color-text-muted)] line-clamp-2">
                {featured.summary}
              </p>
            )}
          </div>
        </a>
      </article>
    )}

    {rest.length > 0 && (
      <ul class="m-0 list-none divide-y divide-[var(--color-border)] p-0">
        {rest.map((article) => (
          <li class="group py-6 lg:py-7">
            <a
              href={article.href}
              class="block no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:rounded-md"
            >
              <p class="mb-2 text-[0.8125rem] font-medium tracking-[0.01em] text-[var(--color-text-light)]">
                <time datetime={article.date.toISOString()}>{formatDate(article.date, locale)}</time>
                <span aria-hidden="true"> · </span>
                <span>{`${article.readingMinutes} ${minReadLabel}`}</span>
              </p>
              <h3 class="mb-2 text-balance font-serif font-medium leading-[1.2] tracking-[-0.005em] text-[var(--color-text)] text-[clamp(1.25rem,2.4vw,1.75rem)] transition-colors duration-200 group-hover:text-[var(--color-accent)]">
                {article.title}
              </h3>
              {article.summary && (
                <p class="max-w-prose text-pretty text-[1rem] leading-relaxed text-[var(--color-text-muted)] line-clamp-1">
                  {article.summary}
                </p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
)}

{showViewAll && articles.length > 0 && (
  <div class="mt-12">
    <a
      href={`${localePrefix(locale)}/blog/`}
      class="inline-flex items-center gap-2 border-b border-[var(--color-accent)]/40 pb-0.5 text-[0.9375rem] font-medium text-[var(--color-accent)] no-underline transition-colors hover:border-[var(--color-accent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:rounded-sm"
    >
      {t(locale, 'viewAllArticles')}
      <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
    </a>
  </div>
)}
