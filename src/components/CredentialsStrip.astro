---
import { type Locale, t } from '../i18n';
import SectionEyebrow from './SectionEyebrow.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const CREDLY_PROFILE_URL =
  'https://www.credly.com/users/xavier-hebert-gueret/badges#credly';

const credentials = [
  { name: 'Certified Kubernetes Administrator (CKA)', issuer: 'Linux Foundation' },
  { name: 'Certified Kubernetes Application Developer (CKAD)', issuer: 'Linux Foundation' },
  { name: 'HashiCorp Certified: Terraform Associate', issuer: 'HashiCorp' },
];
---

<section class="bg-[var(--color-bg)] py-12 lg:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-x-12 gap-y-8 items-start">
      <div>
        <SectionEyebrow text={t(locale, 'credentialsEyebrow')} as="p" class="mb-2" />
        <h2 class="font-serif font-medium text-[var(--color-text)] text-[clamp(1.5rem,3vw,2rem)] leading-tight tracking-tight text-balance m-0">
          {t(locale, 'credentialsTitle')}
        </h2>
      </div>

      <div>
        <ul class="m-0 list-none p-0 space-y-3">
          {credentials.map((c) => (
            <li class="text-[1.0625rem] leading-snug text-pretty">
              <span class="font-semibold text-[var(--color-text)]">{c.name}</span><span class="text-[var(--color-text-muted)]">, {c.issuer}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a
            href={CREDLY_PROFILE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 text-[1.0625rem] font-medium text-[var(--color-accent)] no-underline transition-colors duration-200 hover:text-[var(--color-accent-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:rounded-sm"
          >
            {t(locale, 'credentialsVerify')}
            <svg
              class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
            <span class="sr-only">({t(locale, 'newWindow')})</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
