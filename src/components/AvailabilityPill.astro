---
interface Props {
  href: string;
  label: string;
  isActive?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}

const { href, label, isActive = false, size = 'sm', class: className = '' } = Astro.props;
const sizeClasses = size === 'sm' ? 'px-4 py-2 text-sm' : 'px-4 py-3 text-base';
---

<a
  href={href}
  aria-current={isActive ? 'page' : undefined}
  class:list={[
    'inline-flex items-center gap-2 rounded-full no-underline font-semibold transition-colors',
    sizeClasses,
    'bg-[var(--color-bg-alt)] text-[var(--color-text)] border border-[var(--color-border)] hover:border-[var(--color-accent)]',
    'focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]/40 focus-visible:outline-none',
    isActive && 'ring-2 ring-[var(--color-accent)]/40',
    className,
  ]}
>
  <span class="size-2 rounded-full bg-[var(--color-available)]" aria-hidden="true"></span>
  <span>{label}</span>
</a>
