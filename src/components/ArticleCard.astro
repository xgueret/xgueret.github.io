---
import { type Locale, t } from '../i18n';

interface Props {
  title: string;
  href: string;
  summary?: string;
  image?: string;
  index?: number;
  locale: Locale;
}

const { title, href, summary, image, index = 0, locale } = Astro.props;

const gradients = [
  'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
  'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
  'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
  'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
];
---

<li class="group bg-[var(--color-bg)] border border-[var(--color-border)] rounded-xl overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg cursor-pointer list-none">
  <a href={href} class="block aspect-[3/1] overflow-hidden rounded-t-xl no-underline">
    {image ? (
      <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
    ) : (
      <div class="w-full h-full transition-transform duration-300 group-hover:scale-105" style={`background: ${gradients[index % 4]}`}></div>
    )}
  </a>

  <div class="p-6">
    <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2 leading-snug">
      <a href={href} class="text-inherit no-underline hover:text-[var(--color-accent)] transition-colors">
        {title}
      </a>
    </h3>
    {summary && (
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4 line-clamp-3">
        {summary}
      </p>
    )}
    <a href={href} class="inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)] no-underline hover:gap-2 transition-all">
      {t(locale, 'readMore')}
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
    </a>
  </div>
</li>
