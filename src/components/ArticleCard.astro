---
import { type Locale, t } from '../i18n';

interface Props {
  title: string;
  href: string;
  summary?: string;
  image?: string;
  index?: number;
  locale: Locale;
  seriesName?: string;
  seriesOrder?: number;
}

const { title, href, summary, image, index = 0, locale, seriesName, seriesOrder } = Astro.props;

const episodeLabel =
  seriesOrder !== undefined
    ? `${seriesName ? `${seriesName} · ` : ''}${t(locale, 'episode')} ${seriesOrder}`
    : undefined;

const covers = [
  'var(--color-bg-alt, #f8f3ea)',
  'var(--color-bg-section, #f1ede1)',
  'var(--color-bg-alt, #f8f3ea)',
  'var(--color-bg-section, #f1ede1)',
];
---

<li class="group bg-[var(--color-bg)] border border-[var(--color-border)] rounded-xl overflow-hidden transition-colors duration-200 hover:border-[var(--color-accent)] list-none">
  <a href={href} class="block aspect-[3/1] overflow-hidden rounded-t-xl no-underline focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none">
    {image ? (
      <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
    ) : (
      <div class="w-full h-full transition-transform duration-300 group-hover:scale-105" style={`background: ${covers[index % 4]}`}></div>
    )}
  </a>

  <div class="p-6">
    {episodeLabel && (
      <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)] mb-2 truncate">
        {episodeLabel}
      </p>
    )}
    <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2 leading-snug text-balance">
      <a href={href} class="text-inherit no-underline hover:text-[var(--color-accent)] transition-colors focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none focus-visible:rounded-md">
        {title}
      </a>
    </h3>
    {summary && (
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4 line-clamp-3 text-pretty">
        {summary}
      </p>
    )}
    <a href={href} class="group/link inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)] no-underline focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none focus-visible:rounded-md">
      {t(locale, 'readMore')}
      <svg class="size-3 transition-transform duration-200 group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
    </a>
  </div>
</li>
