---
import { type Locale, t, localePrefix } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import AvailabilityPill from './AvailabilityPill.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname;

const prefix = localePrefix(locale);
const navItems = [
  { name: t(locale, 'cv'), href: `${prefix}/cv/` },
  { name: t(locale, 'posts'), href: `${prefix}/blog/` },
  { name: t(locale, 'projects'), href: `${prefix}/projects/` },
];
const contactHref = `${prefix}/contact/`;
const isContactActive = currentPath === contactHref;
const pillLabel = t(locale, 'availableContact');
---

<nav
  class="fixed top-0 left-0 right-0 h-[var(--navbar-height)] bg-[var(--color-bg)] border-b border-[var(--color-border)] z-50 flex items-center pl-[env(safe-area-inset-left)] pr-[env(safe-area-inset-right)]"
  aria-label={t(locale, 'mainNavigation')}
>
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <!-- Left: Brand + Menu -->
    <div class="flex items-center gap-8">
      <a
        href={`${prefix}/`}
        aria-label={t(locale, 'home')}
        class="font-serif text-2xl font-medium text-[var(--color-text)] no-underline hover:opacity-80 transition-opacity tracking-tight focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]/40 focus-visible:outline-none focus-visible:rounded-md"
      >
        {t(locale, 'author')}
      </a>

      <ul class="hidden md:flex items-center gap-1 list-none m-0 p-0" id="navbar-menu">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'text-[var(--color-text-muted)] no-underline text-lg font-medium px-4 py-2 rounded-md transition-colors',
                'hover:text-[var(--color-text)]',
                'focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]/40 focus-visible:outline-none',
                currentPath === item.href && 'text-[var(--color-text)] bg-[var(--color-accent)]/12',
              ]}
            >
              {item.name}
            </a>
          </li>
        ))}
        <li class="ml-2">
          <AvailabilityPill href={contactHref} label={pillLabel} isActive={isContactActive} size="sm" />
        </li>
      </ul>
    </div>

    <!-- Right: Dark mode + Language -->
    <div class="hidden md:flex items-center gap-4">
      <DarkModeToggle locale={locale} />
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
    </div>

    <!-- Mobile hamburger -->
    <button
      class="md:hidden text-[var(--color-text)] text-xl p-2 border-0 bg-transparent cursor-pointer focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]/40 focus-visible:outline-none rounded-md"
      id="navbar-toggle"
      aria-label={t(locale, 'toggleMenu')}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    class="md:hidden fixed top-[var(--navbar-height)] left-0 right-0 bottom-0 bg-[var(--color-bg)] flex-col p-6 gap-4 -translate-x-full transition-transform duration-200 z-40 hidden"
    id="mobile-menu"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'text-[var(--color-text-muted)] no-underline text-lg font-medium px-4 py-3 rounded-md text-center block',
          'hover:text-[var(--color-text)]',
          'focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]/40 focus-visible:outline-none',
          currentPath === item.href && 'text-[var(--color-text)] bg-[var(--color-accent)]/12',
        ]}
      >
        {item.name}
      </a>
    ))}
    <AvailabilityPill href={contactHref} label={pillLabel} isActive={isContactActive} size="md" class="justify-center mx-auto mt-2" />
    <div class="flex items-center justify-center gap-4 mt-6 pt-6 border-t border-[var(--color-border)]">
      <DarkModeToggle locale={locale} />
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('navbar-toggle');
  const menu = document.getElementById('mobile-menu');

  function closeMenu() {
    menu?.classList.remove('flex', 'translate-x-0');
    menu?.classList.add('hidden', '-translate-x-full');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  function openMenu() {
    menu?.classList.remove('hidden', '-translate-x-full');
    menu?.classList.add('flex', 'translate-x-0');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('translate-x-0');
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('translate-x-0')) {
      closeMenu();
      toggle?.focus();
    }
  });
</script>
