---
import { getAlternateLocale, localizedPath, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  authorName?: string;
  tags?: string[];
}

const { title, description, locale, canonicalUrl, ogImage, ogType = 'website', publishedTime, authorName, tags = [] } = Astro.props;
const altLocale = getAlternateLocale(locale);
const currentPath = Astro.url.pathname;
const site = Astro.site?.toString().replace(/\/$/, '') || '';
const canonical = canonicalUrl || `${site}${currentPath}`;
const altPath = localizedPath(altLocale, currentPath);
const altUrl = `${site}${altPath}`;
const image = ogImage || `${site}/images/moi.png`;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={locale} href={canonical} />
<link rel="alternate" hreflang={altLocale} href={altUrl} />
<link rel="alternate" hreflang="x-default" href={`${site}/`} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Xavier GUERET" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
<meta property="og:locale:alternate" content={altLocale === 'fr' ? 'fr_FR' : 'en_US'} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{ogType === 'article' && publishedTime && (
  <meta property="article:modified_time" content={publishedTime} />
)}
{ogType === 'article' && authorName && (
  <meta property="article:author" content={authorName} />
)}
{ogType === 'article' && tags.length > 0 && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
