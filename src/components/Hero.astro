---
import { type Locale, t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="bg-[var(--color-bg)] py-20 min-h-[calc(100vh-var(--navbar-height))] flex flex-col items-center relative">
  <div class="max-w-[800px] mx-auto px-6 flex flex-col items-start text-left flex-1">
    <!-- Avatar -->
    <div class="mb-6">
      <img
        src="/images/moi.jpg"
        alt={t(locale, 'author')}
        class="w-40 h-40 rounded-full object-cover border-[3px] border-navy shadow-md"
        loading="lazy"
        width="160"
        height="160"
      />
    </div>

    <!-- Content -->
    <div class="flex flex-col items-start w-full">
      <h1 class="text-[3.25rem] font-extrabold text-[var(--color-text)] m-0 leading-[1.15] tracking-tight">
        {t(locale, 'author')}
      </h1>
      <p class="text-[2.75rem] font-light text-[var(--color-text-muted)] mt-1 mb-8 leading-[1.25] tracking-tight">
        {t(locale, 'heroTitle')}
      </p>
      <div class="text-[1.0625rem] text-[var(--color-text-muted)] leading-relaxed mb-10 max-w-[620px] space-y-2">
        {t(locale, 'heroDescription').split('\n').map((line) => (
          <p class="m-0">{line}</p>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="flex gap-4 flex-wrap">
        <a href={`/${locale}/cv/`} class="btn btn-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          {t(locale, 'viewCV')}
        </a>
        <a href="https://www.linkedin.com/in/xavier-gueret-47bb3019b/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          {t(locale, 'contactMe')}
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="#featured" class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-[var(--color-text-muted)] no-underline opacity-60 hover:opacity-100 transition-opacity" aria-label="Scroll down">
    <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
  </a>
</section>
