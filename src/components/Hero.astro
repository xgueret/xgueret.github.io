---
import { type Locale, t } from '../i18n';
import SectionEyebrow from './SectionEyebrow.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const descLines = t(locale, 'heroDescription').split('\n');
// 0 = intro to quote, 1 = quote, 2-3 = paragraphs
---

<section class="bg-[var(--color-bg)] pt-12 lg:pt-20 pb-20 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">

    <div class="grid lg:grid-cols-2 gap-x-12 gap-y-12 items-start">

      <div>
        <SectionEyebrow text={t(locale, 'heroEyebrow')} as="p" class="mb-8" />

        <h1 class="font-extrabold text-[var(--color-text)] m-0 leading-[0.95] tracking-tight text-balance text-[clamp(2.75rem,7vw,5rem)]">
          <span class="block">{t(locale, 'heroHeadline1')}</span>
          <span class="block">{t(locale, 'heroHeadline2')}</span>
          <span class="block italic text-[var(--color-accent)]">{t(locale, 'heroHeadline3')}</span>
        </h1>

        <div class="mt-8 mb-10 max-w-[560px] flex flex-col gap-4">
          <p class="text-[1.0625rem] text-[var(--color-text-muted)] leading-relaxed m-0 text-pretty">
            {descLines[0]}
          </p>
          <blockquote class="border-l-4 border-[var(--color-accent)] pl-5 py-1 italic text-[1.0625rem] text-[var(--color-text)] leading-relaxed text-pretty m-0">
            «&nbsp;{descLines[1]}&nbsp;»
          </blockquote>
          <p class="text-[1.0625rem] text-[var(--color-text-muted)] leading-relaxed m-0 text-pretty">
            {descLines[2]}
          </p>
          <p class="text-[1.0625rem] text-[var(--color-text-muted)] leading-relaxed m-0 text-pretty">
            {descLines[3]}
          </p>
        </div>

        <p class="font-semibold text-sm text-[var(--color-text)] m-0">
          CKA · CKAD · Terraform
        </p>
      </div>

      <div>
        <img
          src="/images/moi.png"
          alt={t(locale, 'author')}
          class="w-full aspect-[4/5] rounded-2xl object-cover shadow-lg"
          loading="eager"
          width="600"
          height="750"
        />
      </div>
    </div>
  </div>

  <a
    href="#featured"
    aria-label={t(locale, 'scrollDown')}
    class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center text-[var(--color-text-muted)] no-underline opacity-60 hover:opacity-100 transition-opacity focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:outline-none focus-visible:rounded-full"
  >
    <svg id="scroll-arrow" class="size-6 animate-bounce motion-reduce:animate-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
  </a>
</section>

<script>
  const arrow = document.getElementById('scroll-arrow');
  if (arrow) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        arrow.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused';
      },
      { threshold: 0 }
    );
    observer.observe(arrow);
  }
</script>
