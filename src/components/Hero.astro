---
import { type Locale, t, localePrefix } from '../i18n';
import SectionEyebrow from './SectionEyebrow.astro';
import HeroPortraitCard from './HeroPortraitCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const prefix = localePrefix(locale);
const descLines = t(locale, 'heroDescription').split('\n');
// 0 = intro to quote, 1 = quote, 2-3 = paragraphs
---

<section class="bg-[var(--color-bg)] pt-16 lg:pt-24 pb-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">

    <div class="grid lg:grid-cols-[1.4fr_1fr] gap-x-16 gap-y-12 items-start">

      <div>
        <SectionEyebrow text={t(locale, 'heroEyebrow')} as="p" class="mb-8" />

        <h1 class="font-serif font-semibold text-[var(--color-text)] m-0 leading-[0.95] tracking-[-0.035em] text-balance text-[clamp(3rem,9vw,6.5rem)]">
          <span class="block">{t(locale, 'heroHeadline1')}</span>
          <span class="block">{t(locale, 'heroHeadline2')}</span>
          <span class="block italic text-[var(--color-coral)]">{t(locale, 'heroHeadline3')}</span>
        </h1>

        <div class="mt-8 mb-10 max-w-[560px] flex flex-col gap-4">
          <p class="text-[0.8125rem] font-medium tracking-[0.01em] text-[var(--color-text-muted)] m-0">
            {descLines[0]}
          </p>
          <blockquote class="font-serif italic text-[1.5rem] text-[var(--color-text)] leading-snug text-pretty m-0 pl-6">
            {descLines[1]}
          </blockquote>
          <p class="text-[1.0625rem] text-[var(--color-text-muted)] leading-relaxed m-0 text-pretty">
            {descLines[2]}
          </p>
          <p class="text-[1.0625rem] text-[var(--color-text-muted)] leading-relaxed m-0 text-pretty">
            {descLines[3]}
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href={`${prefix}/contact/`} class="btn btn-primary">
            {t(locale, 'heroCtaPrimary')}
          </a>
          <a href={`${prefix}/cv/`} class="btn btn-outline">
            {t(locale, 'heroCtaSecondary')}
          </a>
        </div>
      </div>

      <div class="relative grid">
        <div
          aria-hidden="true"
          class="col-start-1 row-start-1 hidden lg:block translate-x-6 translate-y-6 xl:translate-x-8 xl:translate-y-8 bg-[var(--color-accent)] rounded-lg"
        ></div>
        <div class="col-start-1 row-start-1 relative z-10 block">
          <HeroPortraitCard locale={locale} />
        </div>
      </div>
    </div>
  </div>

</section>
