---
/** Which backdrop shape a listing holds — the home's stage 0 (stream) or 3 (helix). */
export type ListingShape = 'stream' | 'helix';

interface Props {
  shape: ListingShape;
}

const { shape } = Astro.props;
const stage = shape === 'helix' ? 3 : 0;
---

<canvas
  id="tp-gl"
  data-stage={stage}
  aria-hidden="true"
  class="fixed inset-0 block w-full h-full z-0 pointer-events-none"
></canvas>

<script>import '../scripts/listing';</script>
