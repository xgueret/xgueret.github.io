---
import { type Locale, t, getAlternateLocale, localizedPath } from '../i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const altLocale = getAlternateLocale(locale);
const altPath = localizedPath(altLocale, currentPath);
---

<div class="flex items-center gap-2 text-base">
  {locale === 'fr' ? (
    <>
      <span class="text-navy font-semibold bg-white rounded px-3 py-1.5" aria-current="true">FR</span>
      <span class="text-white/40" aria-hidden="true">|</span>
      <a href={altPath} aria-label={t(locale, 'switchToEn')} class="text-white/60 font-semibold no-underline px-3 py-1.5 rounded hover:text-white hover:bg-white/10 transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-white/50 focus-visible:outline-none">EN</a>
    </>
  ) : (
    <>
      <a href={altPath} aria-label={t(locale, 'switchToFr')} class="text-white/60 font-semibold no-underline px-3 py-1.5 rounded hover:text-white hover:bg-white/10 transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-white/50 focus-visible:outline-none">FR</a>
      <span class="text-white/40" aria-hidden="true">|</span>
      <span class="text-navy font-semibold bg-white rounded px-3 py-1.5" aria-current="true">EN</span>
    </>
  )}
</div>
