---
import { type Locale, getAlternateLocale, localizedPath } from '../i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const altLocale = getAlternateLocale(locale);
const altPath = localizedPath(altLocale, currentPath);
---

<div class="flex items-center gap-2 text-base">
  {locale === 'fr' ? (
    <>
      <span class="text-navy font-semibold bg-white rounded px-3 py-1.5">FR</span>
      <span class="text-white/40">|</span>
      <a href={altPath} class="text-white/60 font-semibold no-underline px-3 py-1.5 rounded hover:text-white hover:bg-white/10 transition-all">EN</a>
    </>
  ) : (
    <>
      <a href={altPath} class="text-white/60 font-semibold no-underline px-3 py-1.5 rounded hover:text-white hover:bg-white/10 transition-all">FR</a>
      <span class="text-white/40">|</span>
      <span class="text-navy font-semibold bg-white rounded px-3 py-1.5">EN</span>
    </>
  )}
</div>
