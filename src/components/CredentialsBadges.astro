---
import { type Locale, t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const badges = [
  {
    name: 'Certified Kubernetes Administrator (CKA)',
    issuer: 'Linux Foundation',
    year: 2023,
    image: '/images/badges/cka.png',
    href: 'https://www.credly.com/badges/dfcc38d2-4c29-4da4-9483-d96de72a1f29/public_url',
  },
  {
    name: 'Certified Kubernetes Application Developer (CKAD)',
    issuer: 'Linux Foundation',
    year: 2026,
    image: '/images/badges/ckad.png',
    href: 'https://www.credly.com/badges/d4b18a00-4c59-4a0f-a5fb-35e6b4b8236f/public_url',
  },
  {
    name: 'HashiCorp Certified: Terraform Associate',
    issuer: 'HashiCorp',
    year: 2023,
    image: '/images/badges/terraform-associate.png',
    href: 'https://www.credly.com/badges/a20c23e0-e453-433d-a100-e7056fab84be/public_url',
  },
];

const verifyLabel = t(locale, 'credentialsVerify');
const newWindowLabel = t(locale, 'newWindow');
---

<div class="not-prose my-10 lg:my-12 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-section)] p-6 sm:p-8 lg:p-10">
  <ul class="m-0 list-none p-0 grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8">
    {badges.map((b) => (
      <li class="m-0 p-0">
        <a
          href={b.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex h-full flex-col items-center text-center no-underline rounded-md p-4 transition-colors duration-200 hover:bg-[var(--color-bg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          <img
            src={b.image}
            alt={`${b.name} badge`}
            class="h-24 w-24 object-contain"
            width="192"
            height="192"
            loading="lazy"
            decoding="async"
          />
          <p class="mt-4 mb-0 text-[1rem] font-semibold leading-snug text-[var(--color-text)] text-balance">
            {b.name}
          </p>
          <p class={`mt-1 mb-0 text-[0.8125rem] font-medium tracking-[0.01em] text-[var(--color-text-light)]`}>
            {`${b.issuer} · ${b.year}`}
          </p>
          <p class="mt-3 mb-0 inline-flex items-center gap-1 text-[0.8125rem] font-medium text-[var(--color-accent)]">
            {verifyLabel}
            <svg
              class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
            <span class="sr-only">{`(${newWindowLabel})`}</span>
          </p>
        </a>
      </li>
    ))}
  </ul>
</div>
