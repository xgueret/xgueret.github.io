---
import ArticleCard from './ArticleCard.astro';
import { type Locale, t, localePrefix } from '../i18n';

interface Article {
  title: string;
  href: string;
  summary?: string;
  image?: string;
  seriesName?: string;
  seriesOrder?: number;
  date?: Date;
  readingMinutes?: number;
}

interface Props {
  articles: Article[];
  locale: Locale;
  showViewAll?: boolean;
}

const { articles, locale, showViewAll = true } = Astro.props;
---

{articles.length > 0 && (
  <ul class="grid grid-cols-1 md:grid-cols-2 list-none m-0 p-0" style="gap:2px;">
    {articles.map((article) => (
      <ArticleCard
        title={article.title}
        href={article.href}
        summary={article.summary}
        image={article.image}
        locale={locale}
        seriesName={article.seriesName}
        seriesOrder={article.seriesOrder}
        date={article.date}
        readingMinutes={article.readingMinutes}
      />
    ))}
  </ul>
)}

{showViewAll && (
  <div class="mt-10">
    <a href={`${localePrefix(locale)}/blog/`} data-cursor="link" class="tp-link">
      <span>{t(locale, 'blogReadAll')}</span>
      <span class="tp-arrow">↗</span>
    </a>
  </div>
)}
